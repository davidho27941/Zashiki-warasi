# Copy to `.env` and fill in real values before `docker compose up -d`.
# See `deploy/compose/README.md` for a 5-minute quickstart.

# ---------- Database (external Postgres — bring your own) ----------
# SQLAlchemy URL. `postgresql+psycopg://` is required for the driver
# suffix. `postgres` is a placeholder — replace with the real hostname
# reachable FROM inside the container. On Docker Desktop, use
# `host.docker.internal`; on Linux, use the host's LAN IP.
DATABASE_URL=postgresql+psycopg://zashiki:changeme@host.docker.internal:5432/zashiki

# ---------- Checkpointer connection pool (optional; defaults are fine) ----------
# See db-connection-resilience spec for the reasoning behind these defaults.
# DATABASE_CHECKPOINTER_POOL_MIN_SIZE=1
# DATABASE_CHECKPOINTER_POOL_MAX_SIZE=5
# DATABASE_CHECKPOINTER_POOL_MAX_LIFETIME_SECONDS=1800
# DATABASE_CHECKPOINTER_POOL_MAX_IDLE_SECONDS=600

# ---------- HTTP service ----------
# Bind on all interfaces inside the container so the compose port
# mapping can reach it. The `HTTP_BIND_PORT` here also drives the
# host-side port mapping in docker-compose.yml.
HTTP_BIND_HOST=0.0.0.0
HTTP_BIND_PORT=8080
# Shared secret guarding POST /poll and POST /reauth. REQUIRED
# whenever HTTP_BIND_HOST != 127.0.0.1 (which is our default in the
# container). Generate with `openssl rand -hex 32`.
HTTP_API_KEY=change-me-to-a-strong-secret

# ---------- OAuth web flow ----------
# Absolute URL Google will redirect the operator's browser to after
# consent. See docs/oauth-redirect-uri.md for choosing + registering
# this in the Google Cloud Console.
OAUTH_REDIRECT_URI=http://127.0.0.1:8080/auth/callback

# ---------- Google OAuth (client secrets + token cache paths) ----------
# Paths INSIDE the container. The code reads GMAIL_* (env_prefix
# from GmailSettings). Defaults match the volume mounts in
# docker-compose.yml — usually no need to override.
# GMAIL_CREDENTIALS_PATH=/secrets/credentials.json
# GMAIL_TOKEN_PATH=/data/token.json
# Where to find credentials.json on the HOST (mounted into the
# container). Compose-only knob, NOT read by the app. Defaults to
# `./secrets/credentials.json` relative to the compose file.
GMAIL_CREDENTIALS_HOST_PATH=./secrets/credentials.json
# Where to persist /data (contains token.json) on the HOST.
DATA_DIR=./data

# ---------- Gmail client tuning ----------
# GMAIL_HTTP_TIMEOUT_SECONDS=60
# GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ---------- LLM (llama.cpp / OpenAI / Anthropic) ----------
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local-model
# LLM_TEMPERATURE=0.2
# LLM_ANALYZE_MAX_TOKENS=10922

# ---------- Telegram notifications ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_TIMEOUT_SECONDS=10

# ---------- Notion sync (optional — leave blank to disable) ----------
NOTION_TOKEN=
NOTION_EXPENSE_DATABASE_ID=
# NOTION_TIMEOUT_SECONDS=10
# NOTION_SYNC_INTERVAL_SECONDS=300

# ---------- Logging ----------
# Root logger level for third-party libs (httpx, google-auth, etc.).
LOG_LEVEL=INFO
# Override for our own tree — set to DEBUG when debugging without
# unmuting chatty third-party loggers.
# LOG_LEVEL_ZASHIKI=DEBUG
# Log emission format: `text` (default, human-readable one-liner) or
# `json` (one JSON object per line, includes trace_id/span_id when
# tracing is on — feed straight into Fluent Bit / Loki / Vector).
#
# RECOMMENDED FOR THE OBSERVABILITY PROFILE: set to `json` before
# running `docker compose --profile observability up -d`. The Loki
# datasource's derived-field `trace_id → Tempo` regex only matches
# JSON format; text-format logs land in Loki but the trace jump won't
# activate.
# LOG_FORMAT=text

# ---------- OpenTelemetry tracing (v1.1, opt-in) ----------
# Master switch. `1` initializes the SDK, wires up FastAPI / httpx /
# psycopg auto-instrumentation, and connects to the collector below.
# `0` (default) = no SDK import, no OTLP connection attempted.
OTEL_ENABLED=0
# Standard OTel env — becomes the `service.name` resource attribute
# on every exported span. Match this across replicas.
# OTEL_SERVICE_NAME=zashiki-warasi
# OTLP endpoint. `http://otel-collector:4317` is the collector service
# inside this compose network — matches the observability profile.
# For non-compose deploys, point at your own collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Sampler: sampler name + arg (0.0..1.0). Default samples 100% — fine
# at homelab volume (~1500 traces/day). Drop to 0.1 if traffic grows.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# Extra resource attributes (comma-separated k=v). Useful for
# `deployment.environment=prod`, `team=obs`, etc. SHALL NOT contain
# secrets — the app scans this at startup and refuses to boot if it
# looks like a token (sk-, ghp_, AIza, xoxb-, AKIA prefixes, or 32+
# char base64 shape).
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=homelab

# ---------- Observability profile (compose-only, not read by the app) ----------
# These knobs only affect the `--profile observability` services.
# Prometheus retention. Accepts h / d / w / y suffixes. 7d ≈ <100 MB
# at current metric shape; 30d ≈ <500 MB. Set higher if long-term
# trending matters more than disk.
# PROMETHEUS_RETENTION_TIME=7d
# Grafana admin password. Rotate this before uncommenting the
# `0.0.0.0:3000:3000` port mapping in docker-compose.yml —
# loopback-only default protects the placeholder.
# GRAFANA_ADMIN_PASSWORD=change-me-observability
# Loki retention (v1.2 add-log-aggregation-loki). Accepts h / d / w
# suffixes. 7d ≈ TBD MB at current log volume — measure and refine.
# Longer retention grows /loki volume proportionally.
# LOKI_RETENTION_PERIOD=7d
