{
  "annotations": { "list": [] },
  "description": "v1.6.0 laya shadow classifier — LLM vs laya agreement, confusion matrix, shadow health. Observational only: the LLM stays authoritative. Super-class rule (行事曆事件 vs 會議邀請/講座資訊) is already applied inside the agreed label.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Agreement (Phase 2 gate: ≥90% hybrid / 85–90% re-tune / <85% investigate)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Share of scored emails where laya agreed with the LLM, over the dashboard time range. Super-class agreement already counted as agreed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "id": 101,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(zashiki_classifier_shadow_agreement_total{agreed=\"true\"}[$__range])) / sum(increase(zashiki_classifier_shadow_agreement_total[$__range]))",
          "instant": true,
          "legendFormat": "agreement",
          "refId": "A"
        }
      ],
      "title": "Agreement rate (range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Scored comparisons in the range (shadow calls that returned a usable prediction). Errors are excluded — see the health row.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 4, "x": 5, "y": 1 },
      "id": 102,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(zashiki_classifier_shadow_agreement_total[$__range]))",
          "instant": true,
          "legendFormat": "scored",
          "refId": "A"
        }
      ],
      "title": "Scored samples (range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Rolling 24h agreement rate — the number the Phase 2 decision tree reads. Flat-lines until enough mail volume accumulates.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 15, "x": 9, "y": 1 },
      "id": 103,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(increase(zashiki_classifier_shadow_agreement_total{agreed=\"true\"}[24h])) / sum(increase(zashiki_classifier_shadow_agreement_total[24h]))",
          "legendFormat": "agreement (24h rolling)",
          "refId": "A"
        }
      ],
      "title": "Agreement rate over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "LLM category (rows) vs laya category (columns), counts over the dashboard range. Diagonal = agreement; off-diagonal cells are the disagreement clusters worth drilling into (laya_shadow_predictions holds the full rows incl. input_text).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlPu" },
          "custom": { "align": "center", "cellOptions": { "type": "color-background-solid" }, "filterable": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "llm_category" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "auto" } },
              { "id": "custom.align", "value": "left" }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 7 },
      "id": 104,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (llm_category, laya_category) (increase(zashiki_classifier_shadow_agreement_total[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Confusion matrix (LLM rows × laya columns, range)",
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["llm_category", "laya_category", "Value"] } } },
        {
          "id": "groupingToMatrix",
          "options": { "columnField": "laya_category", "rowField": "llm_category", "valueField": "Value" }
        },
        { "id": "renameByRegex", "options": { "regex": "llm_category\\\\laya_category", "renamePattern": "llm_category" } }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 200,
      "panels": [],
      "title": "Shadow health (failures never touch the main pipeline)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "timeout / connection_refused / http_5xx / bad_response / dropped_saturated. One timeout right after a laya-serve restart is the known cold-start signature (see docs/classifier-laya-shadow.md).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 201,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(zashiki_classifier_shadow_error_total[1h]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Shadow errors by reason (per 1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Shadow round-trip (CPU inference on laya-serve). Warm baseline ~0.7–1.0 s for a 1.5k-char input; the client timeout is LAYA_TIMEOUT_SECONDS (prod: 5 s).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 202,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(zashiki_classifier_shadow_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(zashiki_classifier_shadow_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Shadow latency (p50 / p95)",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["zashiki-warasi", "v1.6.0", "laya-shadow"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Zashiki — laya shadow classifier",
  "uid": "zashiki-laya-shadow",
  "version": 1,
  "weekStart": ""
}
