# Version control
.git/
.gitignore
.gitattributes

# Virtualenvs / caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Tests / docs / scratch — all excluded from the image
tests/
docs/
scripts/

# Local session state / assistant scratch
.claude/
openspec/

# Secrets — MUST NOT ship in the image
.env
.env.*
credentials.json
token.json
*.pem
*.key

# Deploy templates — the container ships the app, not the deploy artifacts
deploy/

# Every markdown file except README.md
*.md
!README.md

# Alembic — schemas live in DB; migrations aren't for the container image
migrations/
alembic.ini
